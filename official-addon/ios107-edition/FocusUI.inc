- (void)refresh{if(self.eyeMode){TFFocusBridge *b=TFFocusBridge.shared;[b pump];NSDictionary *q=b.snapshot;unsigned state=[q[@"status"]unsignedIntValue],phase=[q[@"phase"]unsignedIntValue];NSInteger seconds=(NSInteger)ceil(b.remaining);if(state==TF_IDLE||state==TF_STOPPED)seconds=[self.prefs integerForKey:@"minutes"]*60;self.clockLabel.text=q?[NSString stringWithFormat:@"%02ld:%02ld",(long)seconds/60,(long)seconds%60]:@"--:--";self.status.text=!q?TIOText(@"先刷新眼镜状态"):state==TF_RUNNING?(phase?TIOText(@"休息中"):TIOText(@"专注中")):state==TF_PAUSED?TIOText(/*i18n:ui*/@"已暂停"):state==TF_DONE?TIOText(@"这一轮完成了"):TIOText(@"准备开始");UIButtonConfiguration *cfg=self.toggle.configuration;cfg.title=!b.ready?TIOText(@"连接并刷新状态"):state==TF_RUNNING?TIOText(@"暂停"):state==TF_PAUSED?TIOText(@"继续"):TIOText(@"开始专注");self.toggle.configuration=cfg;self.toggle.enabled=!b.busy;self.duration.enabled=state!=TF_RUNNING&&state!=TF_PAUSED&&!b.busy;self.peekButton.hidden=NO;self.peekButton.enabled=!b.busy;self.eyeNote.text=[b.note stringByAppendingString:TIOText(@"\n前3秒完整显示，随后小提示；10秒后释放亮屏保持，随后按系统息屏。短按暂停/继续，长按停止并退出（TFP1-04）；手机断连也可操作。抬头需开启原厂头控；到时空闲才提醒。重启眼镜会中断本轮计时。")];return;}self.toggle.enabled=YES;self.peekButton.hidden=YES;self.eyeNote.text=TIOText(@"本机计时 · 返回或切后台不会重置\n不向眼镜发送，不提供手机后台提醒。");double left=[self remaining];if([self.prefs doubleForKey:@"end"]>0&&left<=0){[self.prefs setDouble:0 forKey:@"end"];[self.prefs setDouble:0 forKey:@"remaining"];}NSInteger seconds=(NSInteger)ceil(left);self.clockLabel.text=[NSString stringWithFormat:@"%02ld:%02ld",(long)seconds/60,(long)seconds%60];BOOL running=[self.prefs doubleForKey:@"end"]>0;UIButtonConfiguration *cfg=self.toggle.configuration;cfg.title=running?TIOText(@"暂停专注"):left<=0?TIOText(@"再来一轮"):TIOText(@"开始 / 继续");self.toggle.configuration=cfg;self.duration.enabled=!running;self.status.text=left<=0?TIOText(@"这一轮完成了，休息一下。"):running?TIOText(@"专注进行中"):TIOText(@"这次，专注一件事。");}
- (void)toggleTimer{if(self.eyeMode){TFFocusBridge *b=TFFocusBridge.shared;if(!b.ready){[b query];[self refresh];return;}unsigned state=[b.snapshot[@"status"]unsignedIntValue];[b perform:state==TF_RUNNING?TF_PAUSE:state==TF_PAUSED?TF_RESUME:TF_START seconds:(state==TF_RUNNING||state==TF_PAUSED)?0:(unsigned)[self.prefs integerForKey:@"minutes"]*60 phase:0];[self refresh];return;}double left=[self remaining];if([self.prefs doubleForKey:@"end"]>0){[self.prefs setDouble:left forKey:@"remaining"];[self.prefs setDouble:0 forKey:@"end"];}else{if(left<=0)left=[self.prefs integerForKey:@"minutes"]*60;[self.prefs setDouble:NSDate.date.timeIntervalSince1970+left forKey:@"end"];}[self refresh];}
