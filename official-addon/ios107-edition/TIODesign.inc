/* TIO_TYPE(Id, token name, size, line height, CSS weight, letter spacing).
 * Phone text styles at the Large content size; UIFontMetrics scales them. */
#define TIO_DESIGN_TYPES(X) \
 X(LargeTitle,"large-title",34,41,700,0.4) \
 X(Title2,"title2",22,28,700,-0.26) \
 X(Title3,"title3",20,25,600,-0.45) \
 X(Headline,"headline",17,22,600,-0.43) \
 X(Body,"body",17,22,400,-0.43) \
 X(Subheadline,"subheadline",15,20,400,-0.23) \
 X(Footnote,"footnote",13,18,400,-0.08) \
 X(Caption,"caption",12,16,400,0)

/* Single numbers: X1(constant suffix, token name, value). Points on the phone,
