/* Turbo IO design tokens, generated by hand from docs/design-system/tokens.json.
 * Plain preprocessor data with no framework dependency: TIODesign.h/.m build
 * UIKit values from it, and the host unit test (TIODesignTests.m) includes the
 * same file and compares every row with tokens.json. Change a value here only
 * together with the spec. Colors are 0xRRGGBB; a light-only token repeats it. */

/* TIO_COLOR(Id, token name, light, dark) */
#define TIO_DESIGN_COLORS(X) \
 X(Bg,"bg",0xf2f2f7,0x17131b) \
 X(BgRaised,"bg-raised",0xffffff,0x221d25) \
 X(BgSunken,"bg-sunken",0xe5e5ea,0x2c2630) \
 X(Label,"label",0x000000,0xf0ede5) \
 X(LabelSecondary,"label-secondary",0x6c6c70,0xa39fa8) \
 X(LabelTertiary,"label-tertiary",0x8a8a8e,0x766f7c) \
 X(Separator,"separator",0xc6c6c8,0x3a3340) \
 X(Accent,"accent",0x4d6c00,0xdbf67a) \
 X(AccentFill,"accent-fill",0x4d6c00,0xdbf67a) \
 X(OnAccent,"on-accent",0xffffff,0x17131b) \
 X(AccentSoft,"accent-soft",0xeef5d6,0x2c3020) \
 X(TileAssistant,"tile-assistant",0x5856d6,0x5e5ce6) \
